# Copier ce fichier en ".env" et adapter les valeurs avant "docker compose up"

POSTGRES_DB=tunisys_ats
POSTGRES_USER=tunisys
POSTGRES_PASSWORD=change_me_postgres

MONGO_USER=tunisys
MONGO_PASSWORD=change_me_mongo

REDIS_PASSWORD=change_me_redis

# Modèle LLM on-premise servi par Ollama (adapter selon la RAM/GPU disponible) :
#   llama3:8b      -> qualité correcte, ~8 Go de RAM/VRAM
#   llama3:70b     -> meilleure qualité, nécessite un GPU costaud
#   mistral:7b     -> alternative plus légère
OLLAMA_MODEL=llama3:8b

JWT_SECRET=change_me_generate_a_long_random_string_min_32_chars

# Email (MailHog est utilise par defaut : aucun compte reel requis, consultez les
# emails recus sur http://localhost:8025). En production, remplacez par un vrai
# serveur SMTP interne ou un fournisseur (SendGrid, etc.) :
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
NOTIF_EMAIL_FROM=no-reply@tunisys.com

# SMS : aucun fournisseur configure par defaut (necessite un compte Twilio/Infobip
# payant). Les SMS sont journalises tant que SMS_PROVIDER=none.
SMS_PROVIDER=none

# URL publique de l'application (utilisee dans les liens envoyes par email :
# reservation d'entretien, E-Assessment...). Changez-la en production pour
# votre nom de domaine reel.
APP_PUBLIC_BASE_URL=http://localhost:4200
